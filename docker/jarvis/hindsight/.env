CONTAINER_NAME=hindsight
VOLUME_NAME=hindsight_data
USER_ID=1000
GROUP_ID=1000
HOST_BIND=127.0.0.1
API_PORT=8888
CP_PORT=9999
# --- LLM for fact extraction (retain pipeline) -------------------------------
# OpenAI-compatible: pointed at the new-api gateway (docker/bifrost/new-api).
# Key lives in sops.env (HINDSIGHT_API_LLM_API_KEY). BASE_URL must end in /v1.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=https://techtales.ai/v1
HINDSIGHT_API_LLM_MODEL=qwen3.8-flash-next
# --- LLM call budget ---------------------------------------------------------
# Thinking off: hindsight's 3.5-4.6k-token extraction prompts made the Qwen3
# template spend ~1k reasoning tokens for ~300 tokens of answer (93-472s per
# call) while the image timeout is 120s — every call was cancelled and retried,
# and cancelled generations kept running on the sparks. Verified via the
# gateway: same call with enable_thinking=false returns in ~1s, 0 reasoning
# tokens. new-api forwards chat_template_kwargs to vLLM.
HINDSIGHT_API_LLM_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false}}'
# Safety net, so one genuinely slow call cannot become a retry storm again.
HINDSIGHT_API_LLM_TIMEOUT=600
HINDSIGHT_API_LLM_MAX_RETRIES=2
HINDSIGHT_API_LLM_INITIAL_BACKOFF=2
HINDSIGHT_API_LLM_MAX_BACKOFF=30
# Image default is 32 concurrent LLM calls against 10 worker slots. Two keeps a
# lane free for consolidation while retain drains; retain is async, so nothing
# waits on the answer. The one provider-wide semaphore means 1 would let a slow
# call stall the whole queue for up to the 600s timeout.
HINDSIGHT_API_LLM_MAX_CONCURRENT=2
# --- Embeddings / rerank ------------------------------------------------------
# Defaults kept on purpose: the full image runs embeddings and reranking
# locally in-process (ONNX/fastembed on CPU) — no Ollama sidecar, no API key,
# nothing leaving the box.
# HINDSIGHT_API_RERANKER_PROVIDER: set to rrf for the algorithmic reranker
# (faster, zero-cost) if the default neural reranker proves too slow on CPU.
# --- Tenant auth ------------------------------------------------------------
# All API calls require the Bearer key from sops.env (HINDSIGHT_API_TENANT_API_KEY);
# the Hermes plugin passes it via its api_key config / HINDSIGHT_API_KEY env.
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
