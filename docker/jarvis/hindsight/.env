CONTAINER_NAME=hindsight
VOLUME_NAME=hindsight_data
USER_ID=1000
GROUP_ID=1000
HOST_BIND=127.0.0.1
API_PORT=8888
CP_PORT=9999
# --- LLM for fact extraction (retain pipeline) -------------------------------
# OpenAI-compatible: pointed at the new-api gateway (docker/bifrost/new-api).
# Key lives in sops.env (HINDSIGHT_API_LLM_API_KEY). BASE_URL must end in /v1.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=https://techtales.ai/v1
HINDSIGHT_API_LLM_MODEL=qwen3.8-flash-next
# --- LLM call budget ---------------------------------------------------------
# Thinking off: hindsight's 3.5-4.6k-token extraction prompts made the Qwen3
# template spend ~1k reasoning tokens for ~300 tokens of answer (93-472s per
# call) while the image timeout is 120s — every call was cancelled and retried,
# and cancelled generations kept running on the sparks. Verified via the
# gateway: same call with enable_thinking=false returns in ~1s, 0 reasoning
# tokens. new-api forwards chat_template_kwargs to vLLM.
HINDSIGHT_API_LLM_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false}}'
# Safety net, so one genuinely slow call cannot become a retry storm again.
HINDSIGHT_API_LLM_TIMEOUT=600
HINDSIGHT_API_LLM_MAX_RETRIES=2
HINDSIGHT_API_LLM_INITIAL_BACKOFF=2
HINDSIGHT_API_LLM_MAX_BACKOFF=30
# Hard ceiling of 1 concurrent LLM call against the gateway, so the whole
# hindsight stack never occupies more than one new-api slot. Trade-off accepted
# 2026-10-26: the one provider-wide semaphore means a single slow call (up to
# the 600s timeout) stalls every queued task until it resolves. Queueing only
# costs latency, never data, so the drain is slower but lossless.
HINDSIGHT_API_LLM_MAX_CONCURRENT=1
# --- Embeddings / rerank ------------------------------------------------------
# Defaults kept on purpose: the full image runs embeddings and reranking
# locally in-process (ONNX/fastembed on CPU) — no Ollama sidecar, no API key,
# nothing leaving the box.
# HINDSIGHT_API_RERANKER_PROVIDER: set to rrf for the algorithmic reranker
# (faster, zero-cost) if the default neural reranker proves too slow on CPU.
# --- Tenant auth ------------------------------------------------------------
# All API calls require the Bearer key from sops.env (HINDSIGHT_API_TENANT_API_KEY);
# the Hermes plugin passes it via its api_key config / HINDSIGHT_API_KEY env.
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
# --- Worker parallelism -------------------------------------------------------
# Back to the image default of 10 concurrent tasks per worker. Task count never
# raises LLM call volume: HINDSIGHT_API_LLM_MAX_CONCURRENT is a provider-wide
# semaphore, so ≤2 extraction calls are in flight regardless of slot count.
# The 2026-10-25 serial experiment bought no call reduction, throttled drain
# throughput, and (PR #11378) exposed a starvation bug. Embeddings/rerank run
# locally on CPU and scale with slots, but 10 ran uneventfully for three weeks.
HINDSIGHT_API_WORKER_MAX_SLOTS=10
# Consolidation keeps its default 2 reserved slots (floor, not ceiling; 2 ≤ 10
# passes the startup validator). Never set MAX_SLOTS=1 with reservation ≥1 —
# shared_pool = slots − reserved and retains only run on shared slots.
# --- Per-bank gateway identity ----------------------------------------------
# Tags outbound LLM/embedding calls with user=<bank_id> so the new-api gateway
# can route/limit per bank and attribute cost.
HINDSIGHT_API_LLM_SEND_BANK_AS_USER=true
# --- Sleep-phase consolidation -----------------------------------------------
# Auto-consolidate-after-retain off: retains still extract facts (recall works
# immediately), consolidation work queues as pending_consolidation and is
# drained nightly at 03:00 by the hermes cron job running drain-consolidation.sh
# in this directory.
HINDSIGHT_API_ENABLE_AUTO_CONSOLIDATION=false
