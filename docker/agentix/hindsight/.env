# Second Hindsight instance (agentix docker host). Structural twin of
# docker/jarvis/hindsight/.env — that file carries the measured rationale for every
# LLM-budget knob; only the differences are annotated here.
CONTAINER_NAME=hindsight
VOLUME_NAME=hindsight_data
USER_ID=1000
GROUP_ID=1000
HOST_BIND=127.0.0.1
API_PORT=8888
CP_PORT=9999
# --- LLM for fact extraction (retain pipeline) -------------------------------
# OpenAI-compatible: pointed at the new-api gateway. Own agentix key in sops.env
# (HINDSIGHT_API_LLM_API_KEY) so gateway cost/limits stay attributable per host.
# BASE_URL must end in /v1.
HINDSIGHT_API_LLM_PROVIDER=openai
HINDSIGHT_API_LLM_BASE_URL=https://techtales.ai/v1
HINDSIGHT_API_LLM_MODEL=qwen3.8-flash-next
# --- LLM call budget ---------------------------------------------------------
# Thinking off: the gateway model spends ~1k reasoning tokens on hindsight's
# 3.5-4.6k-token extraction prompts, which overruns the image's 120s call timeout
# and turns cancelled generations into a retry storm. new-api forwards
# chat_template_kwargs to vLLM.
HINDSIGHT_API_LLM_EXTRA_BODY='{"chat_template_kwargs":{"enable_thinking":false}}'
HINDSIGHT_API_LLM_TIMEOUT=600
HINDSIGHT_API_LLM_MAX_RETRIES=2
HINDSIGHT_API_LLM_INITIAL_BACKOFF=2
HINDSIGHT_API_LLM_MAX_BACKOFF=30
# One concurrent call per host keeps both hindsight instances (jarvis + agentix) at
# two gateway slots in total. Raise only if the queue depth actually lags.
HINDSIGHT_API_LLM_MAX_CONCURRENT=1
# --- Embeddings / rerank ------------------------------------------------------
# Image defaults on purpose: local, in-process (ONNX/fastembed on CPU) — no sidecar,
# no API key, nothing leaving the box.
# --- Tenant auth ------------------------------------------------------------
# All API calls require the Bearer key from sops.env (HINDSIGHT_API_TENANT_API_KEY).
HINDSIGHT_API_TENANT_EXTENSION=hindsight_api.extensions.builtin.tenant:ApiKeyTenantExtension
# --- Worker parallelism -------------------------------------------------------
# Image default. Task slots never raise LLM call volume: MAX_CONCURRENT is the cap.
# Requires the consolidation reservation (image default 2) to stay <= this value.
HINDSIGHT_API_WORKER_MAX_SLOTS=10
# --- Per-bank gateway identity ----------------------------------------------
# Tags outbound LLM/embedding calls with user=<bank_id> for gateway attribution.
HINDSIGHT_API_LLM_SEND_BANK_AS_USER=true
# --- Consolidation ------------------------------------------------------------
# ON here, unlike jarvis: agentix has no Hermes cron draining
# pending_consolidation, and the single LLM slot makes it slow rather than harmful.
HINDSIGHT_API_ENABLE_AUTO_CONSOLIDATION=true

# Stable worker identity — a boot after a hard kill reclaims its OWN in-flight
# tasks. Never share this id with another live replica (jarvis uses hindsight-jarvis).
HINDSIGHT_API_WORKER_ID=hindsight-agentix
