TARGET=jarvis
# sops private key (standard sops CLI location; single source of truth)
SOPS_AGE_KEY_FILE=/home/minerva/.config/sops/age/keys.txt
# required to exist; random value is fine unless webhooks are wired up:
#   mkdir -p ~/.config/doco-cd && openssl rand -hex 16 > ~/.config/doco-cd/webhook_secret
WEBHOOK_SECRET_FILE=/home/minerva/.config/doco-cd/webhook_secret
