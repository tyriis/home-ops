# Plain values — everything the container needs is in sops.env (decrypted by doco-cd at deploy).
# doco-cd target: must match the bifrost poller.
TARGET=bifrost
# tailscale state dir (TS_STATE_DIR). The shared compose binds it with
# create_host_path: false, so this directory MUST exist on bifrost before first deploy.
DATA_PATH=/data/tailscale/state
