TARGET=bifrost
USER_ID=1001
GROUP_ID=1001
WEB_PORT=3000
# Published on all interfaces deliberately (LAN-only host; see docker/bifrost/README.md).
# The shared compose default is 127.0.0.1; with 0.0.0.0 keep a firewall allow-list on
# port 3000 and finish the first-boot setup wizard immediately (unauthenticated until
# the admin account exists).
WEB_HOST=0.0.0.0
